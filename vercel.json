{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "functions": {
    "api/service.ts": {
      "maxDuration": 120,
      "includeFiles": "server/patient-prompt.txt"
    }
  },
  "rewrites": [
    { "source": "/patient-api/:path*", "destination": "/api/service?kind=patient&path=:path*" },
    { "source": "/routing-api/:path*", "destination": "/api/service?kind=routing&path=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
