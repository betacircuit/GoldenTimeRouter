# demo: model-response fixtures; server: SSH-exported public catalog; live: model API.
VITE_DATA_MODE=demo
VITE_API_BASE_URL=/api
# Browser JavaScript key only. Register the app domain in Kakao Developers.
VITE_KAKAO_MAP_APP_KEY=
# Development proxy; server credentials must remain on your backend.
API_PROXY_TARGET=http://127.0.0.1:8000
# Server-only local Vite routing adapter. Never add a VITE_ prefix to this key.
KAKAO_REST_API_KEY=
# Server-only patient extraction. Paste your key in .env.local; never use VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Groq takes priority when configured. Server only; never use a VITE_ prefix.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
